# ===================================
# TalentMind AI — Environment Variables
# ===================================
# Copy this file to .env and fill in the values.

# --- Database ---
# For local development (SQLite):
# DATABASE_URL=sqlite:///./data/talentmind.db
#
# For production (Render PostgreSQL):
# DATABASE_URL=postgresql://user:password@host:5432/talentmind
DATABASE_URL=sqlite:///./data/talentmind.db

# --- Groq API ---
# Required for AI-powered features: Recruiter Copilot, LLM Reranker, JD Parser.
# Without this, the app falls back to heuristic-only mode.
# Get your key at: https://console.groq.com/keys
GROQ_API_KEY=

# --- CORS / Frontend ---
# The URL of the deployed frontend (Vercel domain).
# Used to restrict CORS to only your frontend.
# For local development, use http://localhost:3000 or http://127.0.0.1:5500.
FRONTEND_URL=http://localhost:3000

# --- Server (auto-set by Render) ---
# PORT=8000
